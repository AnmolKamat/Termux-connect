<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.android-sync.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/android-sync</string>
        <string>connect</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>NetworkState</key>
        <true/>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/Shared/android-sync-agent.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/Shared/android-sync-agent-err.log</string>
</dict>
</plist>
